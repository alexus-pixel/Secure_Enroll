DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secureenroll
PORT=5000
JWT_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=

# Comma-separated list of allowed front-end origins for CORS.
# Defaults to the Vite dev server if unset.
ALLOWED_ORIGIN=http://localhost:5173

# SMTP settings for the Teachers "Send PDF" feature. Leave unset
# in dev if you're not testing that feature — every other admin
# endpoint works without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Email existence check on the Add Teacher form, via AbstractAPI's
# Email Validation API (free tier: 100 requests/month, no card
# required). Sign up at https://www.abstractapi.com/email-verification-api
# Leave unset to skip this check entirely — teacher creation still
# works, it just won't verify the email actually exists.
ABSTRACT_EMAIL_API_KEY=
