# Copy this file to .env and fill it in. NEVER commit the real .env.

# --- Database ------------------------------------------------------------------
# Hosted (Neon): set DATABASE_URL and leave the DB_* lines alone.
DATABASE_URL=
# Local Postgres only:
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secureenroll

PORT=5000

# --- Secrets (each person/server generates their own) ---------------------------
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Encrypts sensitive columns. Everyone sharing one database must use the SAME key.
ENCRYPTION_KEY=

# --- Frontend address -----------------------------------------------------------
# The PUBLIC address of the frontend, e.g. https://secureenroll.vercel.app
# Used for (1) the links in verification / reset emails -- if this is localhost,
# a phone cannot open them -- and (2) the CORS allow-list. A comma-separated list
# is fine; emails link to the FIRST one. ALLOWED_ORIGIN, if set, overrides the
# CORS list only.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGIN=

# --- Email ----------------------------------------------------------------------
# Option A (recommended once deployed): Brevo's HTTP API. Render and most cloud
# hosts block SMTP, so this is the one that works there. Create the key in Brevo
# under SMTP & API -> API Keys. The sender must be verified in Brevo
# (Senders, Domains & Dedicated IPs -> Senders).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SecureEnroll

# Option B: any SMTP server (fine on your own computer). If BREVO_API_KEY is set
# it wins. With neither set, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender used for SMTP, and for Brevo when BREVO_SENDER_EMAIL is blank.
SMTP_FROM=SecureEnroll <no-reply@secureenroll.local>

# Email existence check on the Add Teacher form (AbstractAPI free tier, 100/month).
# Leave unset to skip the check; teacher creation still works.
ABSTRACT_EMAIL_API_KEY=
