# Copy this file to ".env" and fill in your own values. Never share the real .env.

PORT=5000

# Database (Neon or local PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random values. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Encrypts birth dates, LRNs and contact details. Do NOT change it once real data exists.
ENCRYPTION_KEY=

# The address where the client (website) runs. It is used in the links inside emails
# and as the allowed origin for the API (CORS). Use the public address when deployed.
CLIENT_URL=http://localhost:5173
# Optional: several allowed origins, separated by commas.
# ALLOWED_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# EMAIL.
#
# 1) Brevo (recommended, and REQUIRED on Render): sends EVERY email - verification,
#    password reset, LRN notices, teacher PDFs - over its web API. Render and most
#    hosts block SMTP ports, so SMTP cannot be used there.
#    Needs BOTH values below. Leave BREVO_API_KEY empty to use SMTP instead.
#    If Brevo refuses (blocked IP, unverified sender) and SMTP below is filled in,
#    the email is sent through SMTP automatically.
#    Test your setup any time with:  node scripts/testEmail.js you@gmail.com
# ---------------------------------------------------------------------------
# A v3 API key (starts with xkeysib-), NOT an SMTP key.
BREVO_API_KEY=
# Must be a sender you verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Caloocan City Elementary School

# 2) SMTP -> used when Brevo is not set up (fine on your own computer, blocked on Render).
#    For Gmail: smtp.gmail.com, port 587, and a 16-letter App Password (not your Gmail password).
#    If SMTP_HOST is empty too, emails are printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Caloocan City Elementary School <your-address@gmail.com>

# Domains besides gmail.com that parents may sign up with, separated by commas.
# MAIL_ALLOWED_DOMAINS=gmail.com

# Behind a proxy (Render sets RENDER=true, and this is then automatic) the server
# reads the visitor's real IP address. Override with the number of proxy hops, or 0.
# TRUST_PROXY=1

# Checks that a teacher's email address really exists (optional, free tier).
# https://www.abstractapi.com/email-verification-api
ABSTRACT_EMAIL_API_KEY=
