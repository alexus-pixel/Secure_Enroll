DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secureenroll
PORT=5000
JWT_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=

# The frontend's URL. Used both to build the links in verification/reset
# emails and to restrict which origin may call this API (CORS).
CLIENT_URL=http://localhost:5173

# SMTP for sending verification and password-reset emails. If SMTP_HOST is
# left blank, emails are printed to the server console instead of sent --
# handy for local development, but set these for anything real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SecureEnroll <no-reply@secureenroll.local>
