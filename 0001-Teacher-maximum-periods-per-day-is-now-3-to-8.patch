     (2,  'Jocelyn',        'Ramos',   'Santos',     'jocelyn.santos@caloocan-es.example',   '09181110002', 'BEEd', 'Generalist',        date '2014-06-02', 'female', '1000002', 'Blk 9 Lot 7 Congress Road, Brgy. 171, Caloocan City'),
